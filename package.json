{
  "name": "template",
  "description": "Self-contained TypeScript library template with a pinned toolchain",
  "keywords": [
    "library-template",
    "oxlint",
    "tsdown",
    "typescript",
    "vitest"
  ],
  "license": "BSD-3-Clause",
  "private": true,
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "version": "0.0.1",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "files": [
    "lib",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "tsdown --config-loader unrun --config tsdown.config.ts",
    "fmt": "oxfmt --config .oxfmtrc.json --write src tests",
    "fmt:check": "oxfmt --config .oxfmtrc.json --check src tests",
    "lint": "oxlint --config .oxlintrc.json --type-check --deny-warnings src tests",
    "lint:fix": "oxlint --config .oxlintrc.json --type-check --deny-warnings --fix src tests",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^22.20.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^4.1.8"
  }
}
